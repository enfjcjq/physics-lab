{
  "name": "physics-lab",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm -w @physics-lab/desktop run dev",
    "build": "npm -w @physics-lab/desktop run build",
    "typecheck": "npm -w @physics-lab/shared run typecheck",
    "test": "vitest --run",
    "package": "npm -w @physics-lab/desktop run build && cd apps/desktop && electron-builder --win zip"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "vitest": "^2.1.0",
    "jsdom": "^25.0.0"
  }
}
